# Example environment variables for English_Word web app
# 請勿在版本控制中提交真實祕密（secret keys / tokens）。

# Flask session secret key
# 在生產環境請設定為長且隨機的字串，例如使用 openssl rand -base64 32
SECRET_KEY=replace-this-with-a-secure-random-value

# API token 用於機器對機器或測試用的 Bearer token
# 留空表示不啟用全域 API token（瀏覽器請使用 session + CSRF）
API_TOKEN=

# 自訂資料庫檔案路徑（相對或絕對），預設為 repository 根目錄下的 vocabulary.db
DB_NAME=vocabulary.db

# 是否在啟動時自動執行 SRS 欄位的 ALTER TABLE（請先備份資料庫）
# 設為 1 以允許 web.py 自動新增 SRS 欄位（next_review, interval, efactor, repetitions）
MIGRATE_SRS=0

# 用於開發 / 偵錯（可選）
# FLASK_ENV=development
# DEBUG=1
